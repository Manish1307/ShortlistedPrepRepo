
# The website (home page), static files built by website/build.js. Added by deploy/setup.sh when a site host is given.
__SITE_HOST__ {
	encode gzip
	root * /opt/shortlistprep/website
	try_files {path} {path}.html {path}/index.html
	# browsers keep the files for 30 days; .css/.js are versioned with ?v=, so changes still arrive
	header /assets/* Cache-Control "public, max-age=2592000"
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	file_server
}
